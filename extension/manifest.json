{
  "manifest_version": 3,
  "name": "Live Translator",
  "version": "0.1.0",
  "description": "Real-time voice translation for Google Meet",

  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture",
    "tabs"
  ],

  "host_permissions": [
    "https://meet.google.com/*"
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Live Translator"
  }
}