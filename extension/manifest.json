{
  "manifest_version": 3,
  "name": "Live Translator",
  "version": "0.1.0",
  "description": "Real-time voice translation for Google Meet",

  "permissions": [
    "activeTab",
    "scripting",
    "tabCapture"
  ],

  "host_permissions": [
    "https://meet.google.com/*"
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content.js"],
      "css": ["src/overlay.css"]
    }
  ],

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Live Translator"
  }
}